# Copy to .env and fill in. Never commit .env.

# --- Required: the app refuses to start if either is empty or a known default.
# Generate each one separately:  openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=

# --- Database: PostgreSQL is required (SQLite is not supported, see README).
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@localhost:5432/web_voting

# --- Cache / rate limit / realtime. Use memory:// for single-process local dev.
REDIS_URL=redis://localhost:6379/0

APP_BASE_URL=http://localhost:8000
# true also echoes every SQL statement: dev only, never in production.
DEBUG=false

# --- Performance knobs (defaults sized for 2 workers on a 2 vCPU / 2 GB VM,
# see deploy/README.md). Pool is per worker process.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_SECONDS=15
# Requests per minute per client IP (venue Wi-Fi / carrier NAT share one IP).
# RATE_LIMIT_PUBLIC_PER_MIN=3000
# RATE_LIMIT_PAYMENT_PER_MIN=200
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_WEBHOOK_PER_MIN=600
# At most one leaderboard SSE push per event per window (seconds).
# LEADERBOARD_PUSH_INTERVAL_SECONDS=1.0

# --- Midtrans (QRIS). With keys set, real invoices and signed webhooks are used.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

DUITKU_MERCHANT_CODE = 
DUITKU_API_KEY = 
DUITKU_ENVIRONMENT = sandbox

# --- Local dev WITHOUT Midtrans: fake QRIS + unsigned webhook + /payments/mock/*.
# Must stay false everywhere else; the app rejects it combined with a server key
# or MIDTRANS_IS_PRODUCTION=true. With no keys and this false, payments return 503.
MIDTRANS_MOCK_MODE=false
